<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://accounts.google.com/gsi/client https://apis.google.com; frame-src https://accounts.google.com/gsi/ https://docs.google.com https://content.googleapis.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' blob: data:; font-src 'self'; media-src 'self' blob: data: https:; connect-src 'self' blob: https: wss:;"
    # Ensure browsers pick up new hashed JS/CSS after each deploy.
    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Stylesheets are UTF-8. Without a charset a browser decodes a linked stylesheet
# with the encoding of the page that links it, so a UTF-16 index.html turns the
# whole stylesheet into mojibake (unstyled page).
AddCharset UTF-8 .css
