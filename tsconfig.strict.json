{
  // The strictness ratchet (#365): the base config plus
  // noUncheckedIndexedAccess + exactOptionalPropertyTypes. All of src/, tests
  // included, is clean: `npm run typecheck:strict` (scripts/check-strict.mjs)
  // fails on any error. tsconfig.strict-next.json is the next ratchet.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
