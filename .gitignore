node_modules/
dist/
coverage/
*.local
.DS_Store
native/build/
native/build-host/
native/build-host-clang/
native/build-fuzz/
native/build-debug/
# clangd database: generated by the cmake configure (see native/.clangd)
native/compile_commands.json

# Python bytecode (from local hf_space syntax checks)
__pycache__/
*.pyc

# Auto-caption WASM build + weights (optional, built on demand — see
# native/whisper/README.md). Too large to commit; the feature hides itself
# when they are absent.
native/whisper/third_party/
public/wasm/whisper.js
public/wasm/whisper.wasm
public/models/

# RIFE Space runtime output (stitched renders, thumbnails).
huggingface/**/workspace_temp/

# Self-hosted FFmpeg cores: generated from node_modules by
# `npm run sync:ffmpeg-core` (run by predev / prebuild). 32 MB each, so they
# stay out of history.
public/ffmpeg-core/
public/ffmpeg-core-mt/

# Playwright (e2e/)
test-results/
playwright-report/
