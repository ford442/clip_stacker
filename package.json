{
  "name": "clip_stacker",
  "version": "1.0.0",
  "description": "Upload, trim, reorder, fade, and merge video clips into one MP4 using FFmpeg WebAssembly",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/utf16-dual-encode.mjs",
    "build:utf16": "node scripts/utf16-dual-encode.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && python3 deploy.py",
    "deploy:rife-space": "bash scripts/deploy-rife-space.sh",
    "build:audio-analysis": "bash scripts/build-audio-analysis.sh",
    "build:time-stretch": "bash scripts/build-time-stretch.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "wasm",
    "clip-editor"
  ],
  "author": "ford442",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@tanstack/react-virtual": "^3.14.8",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.7",
    "@webgpu/types": "^0.1.70",
    "happy-dom": "^20.9.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
